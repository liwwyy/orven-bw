{
  "schemaVersion": 1,
  "id": "orven-bw",
  "version": "${version}",
  "name": "orven-bw — Click Recording",
  "description": "Physical click timing recorder. Logging starts automatically; optional utilities are disabled by default.",
  "authors": ["liwwyy"],
  "environment": "client",
  "custom": {"orvenbw:build_flavor": "recording"},
  "entrypoints": {"client": ["io.github.liwwyy.orvenbw.OrvenBw"]},
  "mixins": ["orven-bw.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.8.9",
    "java": ">=25",
    "oneconfigv1": ">=1.2.18",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
  }
}
